<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Samostoyayka.ViewModels"
             x:Class="Samostoyayka.Views.SettingsPage"
             Title="Настройки">

    <VerticalStackLayout Padding="30,20" Spacing="20">

        <!-- Поле ввода и кнопка добавления -->
        <HorizontalStackLayout Spacing="10">
            <Entry Text="{Binding NewTaskTitle}" Placeholder="Новая задача..." WidthRequest="250" />
            <Button Text="+" Command="{Binding AddTaskCommand}" WidthRequest="50" FontAttributes="Bold" />
        </HorizontalStackLayout>

        <Label Text="Все задачи:" FontSize="20" FontAttributes="Bold" Margin="0,20,0,0"/>

        <!-- Список всех задач для управления -->
        <CollectionView ItemsSource="{Binding AllChores}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Spacing="15" Padding="0, 10">
                        <Label Text="{Binding Title}" VerticalOptions="Center" FontSize="18" WidthRequest="220" />
                        <Button Text="❌" 
                                BackgroundColor="Transparent" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SettingsViewModel}}, Path=DeleteTaskCommand}"
                                CommandParameter="{Binding .}" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>